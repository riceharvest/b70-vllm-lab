--- a/triton/backends/intel/driver.py
+++ b/triton/backends/intel/driver.py
@@ -30,6 +30,41 @@
 ARG_TUPLE = None
 
 
+def _sycl_runtime_already_loaded() -> tuple[list[str], list[str]] | None:
+    """Locate the SYCL C++ runtime already mapped in this process.
+
+    Returns ``(include_dirs, lib_dirs)`` for that runtime, or None.
+
+    A runtime that is already loaded owns the ``sycl::queue`` objects we are
+    about to be handed.  A triton module compiled against a *different*
+    libsycl will interpret them with the wrong ABI, and
+    ``sycl::context::get_devices()`` then dereferences a vtable belonging to
+    the wrong runtime -> SIGSEGV.
+
+    Both headers and libraries must come from the same runtime, so derive the
+    include dirs from the lib dir (wheel layout: ``<root>/lib`` next to
+    ``<root>/include``).  If no SYCL header is found there we return None so
+    the caller keeps its existing search order rather than building without
+    headers.
+    """
+    try:
+        with open("/proc/self/maps") as f:
+            maps = f.read()
+    except OSError:
+        return None
+    for line in maps.splitlines():
+        path = line.rpartition(" ")[-1]
+        if not os.path.basename(path).startswith("libsycl.so"):
+            continue
+        lib_dir = os.path.dirname(os.path.realpath(path))
+        root = os.path.dirname(lib_dir)
+        includes = [os.path.join(root, "include"), os.path.join(root, "include", "sycl")]
+        if not any(os.path.exists(os.path.join(d, "sycl", "sycl.hpp")) for d in includes):
+            return None
+        return includes, [lib_dir]
+    return None
+
